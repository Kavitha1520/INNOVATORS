{
  "name": "brandshield-ai",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python backend/app.py",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview -- --host 0.0.0.0",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "python -m pip install -r backend/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
